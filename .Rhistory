source("M_manual/config_M.R"); source("M_manual/functions_M.R")
dat <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
dat <- dat[order(dat$sample_number), ]
num <- suppressWarnings(as.integer(sub("^F", "", dat$sample_number)))
y <- dat[[M_TARGET]]
pal_i <- which(dat$location == "BEZOS Palmira")
block <- pal_i[num[pal_i] >= 264238]                 # affected stretch
clean <- pal_i[num[pal_i] < 264238]                  # clean Palmira plots
# Model trained only on clean data
train <- c(which(dat$location != "BEZOS Palmira"), clean)
train <- train[!is.na(y[train])]
X <- rf_matrix(dat$spc_pretreated)
m <- fit_qrf(X[train, ], y[train], num_trees = 1000)
p <- predict_qrf(m, X[block, ], seed = M_RF_SEED)$pred
# Pair each spectrum with the lab value of sample number + k
y_num <- setNames(y, num)
fit_pairs <- function(lab, label) {
ok <- !is.na(lab)
data.frame(hypothesis = label, n = sum(ok),
RMSE = round(sqrt(mean((p[ok] - lab[ok])^2)), 3),
ME = round(mean(p[ok] - lab[ok]), 3),
R2 = round(cor(p[ok], lab[ok])^2, 3))
}
res <- do.call(rbind, lapply(-4:4, function(k)
fit_pairs(y_num[as.character(num[block] + k)],
if (k == 0) "as recorded (shift 0)" else sprintf("shift %+d", k))))
# Swap 10-30 <-> 60-100 within the same plot
y_unit_top <- setNames(y, paste(dat$unit, dat$top))
swap_top <- c("0" = 0, "10" = 60, "30" = 30, "60" = 10)[as.character(dat$top[block])]
res <- rbind(res, fit_pairs(y_unit_top[paste(dat$unit[block], swap_top)], "swap 10-30 <-> 60-100"))
cat("Affected stretch:", length(block), "samples\n")
print(res[order(res$RMSE), ], row.names = FALSE)
# Model without any Palmira sample (no bias for any part of the sequence)
train2 <- which(dat$location != "BEZOS Palmira" & !is.na(y))
m2 <- fit_qrf(X[train2, ], y[train2], num_trees = 1000)
p_all <- predict_qrf(m2, X[pal_i, ], seed = M_RF_SEED)$pred
# For each Palmira plot: squared error as recorded (shift 0) and with shift +1
pp <- data.frame(i = pal_i, unit = dat$unit[pal_i], num = num[pal_i], top = dat$top[pal_i],
pred = p_all, lab0 = y[pal_i], lab1 = y_num[as.character(num[pal_i] + 1)])
pp <- data.frame(i = pal_i, unit = dat$unit[pal_i], num = num[pal_i], top = dat$top[pal_i],
pred = p_all, lab0 = y[pal_i],
lab1 = unname(y_num[as.character(num[pal_i] + 1)]))
per_plot <- do.call(rbind, lapply(split(pp, pp$unit), function(x) {
ok <- !is.na(x$lab0) & !is.na(x$lab1)
data.frame(unit = x$unit[1], first = min(x$num), n = sum(ok),
sse0 = sum((x$pred[ok] - x$lab0[ok])^2), sse1 = sum((x$pred[ok] - x$lab1[ok])^2))
}))
per_plot <- per_plot[order(per_plot$first), ]
per_plot$best <- ifelse(per_plot$sse1 < per_plot$sse0, "shift +1", "as recorded")
rr <- rle(per_plot$best)
print(data.frame(best = rr$values, plots = rr$lengths,
from = paste0("F", per_plot$first[cumsum(rr$lengths) - rr$lengths + 1]),
to = paste0("F", per_plot$first[cumsum(rr$lengths)])), row.names = FALSE)
source("config.R"); source("functions.R")
raw <- read_winisi_nir(FILE_SPECTRA)
raw$position <- seq_len(nrow(raw))           # order in which the spectra were saved
num_raw <- suppressWarnings(as.integer(sub("^F", "", raw$sample_number)))
# 1. Palmira samples scanned more than once
pal_raw <- raw[!is.na(num_raw) & num_raw >= 264022 & num_raw <= 264573, ]
cat("Palmira records in the file:", nrow(pal_raw), "| distinct samples:",
length(unique(pal_raw$sample_number)), "\n")
dup <- pal_raw$sample_number[duplicated(pal_raw$sample_number)]
cat("Samples scanned more than once:", if (length(dup)) paste(dup, collapse = ", ") else "none", "\n")
# 2. Order: is every sample saved after the previous sample number?
pal_raw <- pal_raw[order(pal_raw$position), ]
n_pal <- num_raw[pal_raw$position]
jumps <- which(diff(n_pal) != 1)
cat("\nPlaces where the sample number does not increase by 1 in the file order:\n")
print(data.frame(position = pal_raw$position[jumps],
sample = pal_raw$sample_number[jumps],
next_sample = pal_raw$sample_number[jumps + 1]), row.names = FALSE)
