# ---- Check: relative bias of SOC 0-30 cm in Palmira (Respaldo A) ----
rel_bias <- function(f) {
p <- read.csv(f)
x <- p[p$version == "B" & p$source == "DRS" & p$location == "BEZOS Palmira" &
!is.na(p$soc_lab) & !is.na(p$soc_aug), ]
data.frame(file = f, profiles = nrow(x),
lab_mean = round(mean(x$soc_lab), 3),
pred_mean = round(mean(x$soc_aug), 3),
bias = round(mean(x$soc_aug - x$soc_lab), 3),
rel_bias_pct = round(100 * mean(x$soc_aug - x$soc_lab) / mean(x$soc_lab), 1))
}
# 1. After the correction (current results)
rel_bias("outputs/M_manual/tables/M07_profiles_0_30.csv")
# 2. Look for older copies of the same table, with their dates
old <- list.files("C:/Vis_NIR_SOC", pattern = "M07_profiles_0_30.*\\.csv$",
recursive = TRUE, full.names = TRUE)
file.info(old)[, "mtime", drop = FALSE]
