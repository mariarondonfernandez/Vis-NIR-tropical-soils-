# M_manual/M11_qrf_explain.R
# QRF explained with the data of this project (presentation and thesis).
# Uses the final model of version B saved by M06 (M06_model_B.rds) and the
# predictions of M06 (M06_predictions.csv). It does not refit the model.
# 1. Hyperparameters of the fitted model.
# 2. Leaf size: calibration samples in each terminal node.
# 3. QRF weights for two validation samples: weighted distribution of the
#    calibration SOC, with mean, median and 5-95% quantiles.
# 4. Mean of 100 draws (as in M06) vs the exact median and quantiles of ranger.
# 5. Coverage of the 90% interval (PICP) and mean width, by location, depth
#    class and applicability domain.
# 6. Figures: weights of the two samples, interval width vs observed SOC,
#    interval width vs GH distance.
# Note on ranger: for each tree, ranger keeps one calibration value drawn at
# random from each leaf. A prediction collects one value per tree (3500
# values); on average this gives the weights of Meinshausen (2006).
# Time: about 3-5 minutes.
source("config.R")
source("functions.R")
source("M_manual/config_M.R")
source("M_manual/functions_M.R")
library(ggplot2)
# ---- Data (as in M06) --------------------------------------------------------------------
dat <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
sp <- readRDS(file.path(DIR_M_PROCESSED, "M04_split.rds"))$split
pop <- dat[!is.na(dat[[M_TARGET]]), ]
pop$location <- as.character(pop$location)
pop$set_B <- sp$set_B[match(pop$sample_number, sp$sample_number)]
X <- rf_matrix(pop$spc_pretreated)
y <- pop[[M_TARGET]]
cal <- which(pop$set_B == "calibration")
prd <- which(pop$set_B == "prediction")
model <- readRDS(file.path(DIR_M_PROCESSED, "M06_model_B.rds"))
pr <- read.csv(file.path(DIR_M_TABLES, "M06_predictions.csv"))
pr <- pr[pr$version == "B", ]
pr <- pr[match(pop$sample_number[prd], pr$sample_number), ]
if (anyNA(pr$sample_number)) stop("M06_predictions.csv does not match the split: run M06 again")
# ---- 1. Hyperparameters --------------------------------------------------------------------
hp <- data.frame(
ranger_version = as.character(packageVersion("ranger")),
num_trees = model$num.trees,
mtry = model$mtry,
predictors = model$num.independent.variables,
mtry_share_pct = round(100 * model$mtry / model$num.independent.variables, 1),
min_node_size = model$min.node.size,
splitrule = model$splitrule,
calibration_samples = model$num.samples,
oob_rmse = round(sqrt(model$prediction.error), 3)
)
cat("\n== 1. Hyperparameters of the final model (version B) ==\n")
print(t(hp))
# ---- 2. Leaf size ------------------------------------------------------------------------------
# Terminal node of every calibration sample in every tree (n_cal x trees)
tn_cal <- predict(model, X[cal, , drop = FALSE], type = "terminalNodes")$predictions
library(ranger)
library(ranger)   # predict() of a saved ranger model needs the package attached
source("C:/Vis_NIR_SOC/M_manual/M11_qrf_explain.R", echo = TRUE)
# ---- Respaldo A: Palmira before vs after the spectral correction --------------
# Same calibration samples and same Palmira validation samples (split B).
# Before: QRF fitted and evaluated with the spectra as recorded (before QC).
# After: final model of M06, spectra after QC.
# Time: about 3-5 minutes (one QRF with 3500 trees).
source("config.R")
source("functions.R")
source("M_manual/config_M.R")
source("M_manual/functions_M.R")
library(ranger)
after  <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
before <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra_before_qc.rds"))
sp <- readRDS(file.path(DIR_M_PROCESSED, "M04_split.rds"))$split
pop <- after[!is.na(after[[M_TARGET]]), ]
pop$location <- as.character(pop$location)
pop$set_B <- sp$set_B[match(pop$sample_number, sp$sample_number)]
cal <- which(pop$set_B == "calibration")
pal <- which(pop$set_B == "prediction" & pop$location == "BEZOS Palmira")
y <- pop[[M_TARGET]]
# Spectra as recorded for the same sample numbers
ib <- match(pop$sample_number, before$sample_number)
if (anyNA(ib)) stop(sum(is.na(ib)), " samples not found in M02_spectra_before_qc.rds")
X_after  <- rf_matrix(pop$spc_pretreated)
X_before <- rf_matrix(before$spc_pretreated[ib, , drop = FALSE])
m_after  <- readRDS(file.path(DIR_M_PROCESSED, "M06_model_B.rds"))
m_before <- fit_qrf(X_before[cal, , drop = FALSE], y[cal])
p_after  <- predict_qrf(m_after,  X_after[pal, , drop = FALSE],  seed = M_RF_SEED)$pred
p_before <- predict_qrf(m_before, X_before[pal, , drop = FALSE], seed = M_RF_SEED)$pred
metrics_ab <- function(label, o, p) {
e <- p - o
data.frame(version = label, n = length(o),
RMSE = round(sqrt(mean(e^2)), 3),
ME = round(mean(e), 3),
R2_true = round(1 - sum(e^2) / sum((o - mean(o))^2), 3),
r2_pearson = round(cor(o, p)^2, 3))
}
res <- rbind(metrics_ab("before (as recorded)", y[pal], p_before),
metrics_ab("after (corrected)", y[pal], p_after))
print(res, row.names = FALSE)
write.csv(res, file.path(DIR_M_TABLES, "M11b_palmira_before_after.csv"), row.names = FALSE)
