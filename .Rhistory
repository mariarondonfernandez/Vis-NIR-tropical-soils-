d <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
# GH distance on the pretreated spectra (5 PCs), mean absorbance and value at 640 nm
pca <- prcomp(d$spc_pretreated, center = TRUE, scale. = FALSE)
sc  <- pca$x[, 1:5]
gh  <- rowSums(sweep(sc, 2, apply(sc, 2, sd), "/")^2) / 5
check <- data.frame(
sample = d$sample_number, location = d$location, top = d$top, bottom = d$bottom,
tc = d$tc, mean_abs = round(rowMeans(d$spc_resampled), 3),
gh = round(gh, 1), d640 = round(d$spc_pretreated[, "640"], 2), label = d$label
)
# 1. Samples farthest from the rest (highest GH)
head(check[order(-check$gh), ], 15)
# 2. Brightest and darkest spectra
head(check[order(check$mean_abs), ], 5)
head(check[order(-check$mean_abs), ], 5)
# 3. Samples with the strongest dip at 640 nm
head(check[order(check$d640), ], 10)
# 4. How many samples have GH > 3, by location
table(check$location[check$gh > GH_LIMIT])
# 5. Plot the raw spectra of the 10 samples with the highest GH
top <- match(head(check$sample[order(-check$gh)], 10), d$sample_number)
matplot(as.numeric(colnames(d$spc_resampled)), t(d$spc_resampled[top, ]),
type = "l", lty = 1, xlab = "Wavelength [nm]", ylab = "Absorbance")
