source("config.R"); source("functions.R")
source("M_manual/config_M.R"); source("M_manual/functions_M.R")
dat <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
dat <- dat[order(dat$sample_number), ]
num <- suppressWarnings(as.integer(sub("^F", "", dat$sample_number)))
y <- dat[[M_TARGET]]
X <- rf_matrix(dat$spc_pretreated)
y_num <- setNames(y, num)
targets <- c("GANSO Costa Caribe", "GANSO Magdalena Medio", "GANSO Orinoquia")
shift_tab <- list(); per_tab <- list()
for (l in targets) {
li <- which(dat$location == l & !is.na(num))
tr <- which(dat$location != l & !is.na(y))
m <- fit_qrf(X[tr, ], y[tr], num_trees = 1000)
p <- predict_qrf(m, X[li, ], seed = M_RF_SEED)$pred
rm(m); gc()
# Global shift: lab value of sample number + k
shift_tab[[l]] <- do.call(rbind, lapply(-3:3, function(k) {
lab <- unname(y_num[as.character(num[li] + k)])
ok <- !is.na(lab)
data.frame(location = l, shift = k, n = sum(ok),
RMSE = round(sqrt(mean((p[ok] - lab[ok])^2)), 3),
R2 = round(cor(p[ok], lab[ok])^2, 3))
}))
# By profile: as recorded, shift +1 or shift -1
pp <- data.frame(pid = paste(dat$dataset[li], dat$profile[li]), num = num[li], pred = p,
lab0 = y[li], lab_p1 = unname(y_num[as.character(num[li] + 1)]),
lab_m1 = unname(y_num[as.character(num[li] - 1)]))
per <- do.call(rbind, lapply(split(pp, pp$pid), function(x) {
ok <- complete.cases(x[, c("lab0", "lab_p1", "lab_m1")])
data.frame(location = l, pid = x$pid[1], first = min(x$num),
sse0 = sum((x$pred[ok] - x$lab0[ok])^2),
sse_p1 = sum((x$pred[ok] - x$lab_p1[ok])^2),
sse_m1 = sum((x$pred[ok] - x$lab_m1[ok])^2))
}))
per <- per[order(per$first), ]
per$best <- c("as recorded", "shift +1", "shift -1")[apply(per[, c("sse0", "sse_p1", "sse_m1")], 1, which.min)]
per_tab[[l]] <- per
}
cat("== Global shift by location (lowest RMSE = best pairing) ==\n")
print(do.call(rbind, shift_tab), row.names = FALSE)
for (l in targets) {
per <- per_tab[[l]]
cat("\n==", l, ": profiles by best pairing ==\n"); print(table(per$best))
rr <- rle(per$best)
runs <- data.frame(best = rr$values, profiles = rr$lengths,
from = paste0("F", per$first[cumsum(rr$lengths) - rr$lengths + 1]),
to = paste0("F", per$first[cumsum(rr$lengths)]))
long <- runs[runs$best != "as recorded" & runs$profiles >= 3, ]
cat("Runs of 3 or more shifted profiles in a row:", nrow(long), "\n")
if (nrow(long)) print(long, row.names = FALSE)
}
