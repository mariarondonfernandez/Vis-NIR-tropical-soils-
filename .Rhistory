dat <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
sp <- readRDS(file.path(DIR_M_PROCESSED, "M04_split.rds"))$split
pop <- dat[!is.na(dat[[M_TARGET]]), ]
pop$location <- as.character(pop$location)
pop$project <- sub(" .*", "", pop$location)
pop$set_B <- sp$set_B[match(pop$sample_number, sp$sample_number)]
X <- rf_matrix(pop$spc_pretreated)
y <- pop[[M_TARGET]]
cal <- which(pop$set_B == "calibration")
prd <- which(pop$set_B == "prediction")
stages <- list(stage1 = "HSJ", stage2 = c("HSJ", "GANSO"))
out <- data.frame(sample_number = pop$sample_number[prd])
for (s in names(stages)) {
cs <- cal[pop$project[cal] %in% stages[[s]]]
m <- fit_qrf(X[cs, , drop = FALSE], y[cs])
out[[s]] <- predict_qrf(m, X[prd, , drop = FALSE], seed = M_RF_SEED)$pred
rm(m); gc()
}
write.csv(out, file.path(DIR_M_TABLES, "M09_stage_predictions.csv"), row.names = FALSE)
cal_counts <- as.data.frame(table(location = pop$location[cal]))
write.csv(cal_counts, file.path(DIR_M_TABLES, "M09_calibration_by_location.csv"), row.names = FALSE)
print(cal_counts)
