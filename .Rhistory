dat <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
pal <- dat[dat$location == "BEZOS Palmira", ]
S <- pal$spc_pretreated
D <- 0.5 * (1 - cor(t(S)))   # correlation dissimilarity between all Palmira spectra
diag(D) <- NA
nn_dist <- apply(D, 1, min, na.rm = TRUE)
cat("Typical distance to the nearest spectrum (all Palmira):\n")
print(round(quantile(nn_dist, c(0.05, 0.25, 0.5, 0.75)), 5))
flag_ids <- d$sample_number[d$flag == "low obs, high pred"]
r <- readRDS(file.path(DIR_A_PROCESSED, "A01v2.rds"))
pd <- r$predictions[r$predictions$target == "BEZOS Palmira" &
r$predictions$approach == "GeSearch + 20", ]
flag_ids <- pd$sample_number[pd$obs < 0.5 & pd$pred > 0.9]
cat("Flagged samples:", length(flag_ids), "\n")
res <- do.call(rbind, lapply(flag_ids, function(s) {
i <- match(s, pal$sample_number)
nn <- which.min(D[i, ])
same <- which(pal$unit == pal$unit[i])
same <- same[same != i]
data.frame(sample = s, top = pal$top[i], nearest = pal$sample_number[nn],
nearest_top = pal$top[nn], nearest_same_plot = pal$unit[nn] == pal$unit[i],
d_nearest = round(D[i, nn], 5),
d_0_10 = round(D[i, same[pal$top[same] == 0]][1], 5),
d_10_30 = round(D[i, same[pal$top[same] == 10]][1], 5))
}))
cat("\nFlagged samples: is the nearest spectrum in the same plot, and at which depth?\n")
print(table(same_plot = res$nearest_same_plot, nearest_top = res$nearest_top))
cat("\nDistance of flagged samples to their nearest spectrum:\n")
print(round(quantile(res$d_nearest, c(0.05, 0.25, 0.5, 0.75)), 5))
print(head(res, 20), row.names = FALSE)
# Within-plot distances between the four layers, for every Palmira plot
layers <- c(0, 10, 30, 60)
pd$type <- ifelse(pd$obs < 0.5 & pd$pred > 0.9, paste0("flag_", pd$top), "")
w <- do.call(rbind, lapply(unique(pal$unit), function(p) {
i <- which(pal$unit == p)
i <- i[match(layers, pal$top[i])]
if (anyNA(i)) return(NULL)
dd <- D[i, i]
fl <- pd$type[match(pal$sample_number[i], pd$sample_number)]
group <- if (all(is.na(fl))) "lab or not evaluated" else
if (any(fl %in% "flag_30")) "flag 30-60" else
if (any(fl %in% "flag_60")) "flag 60-100" else "no flag"
data.frame(plot = p, first = min(pal$sample_number[i]), group = group,
d_0_10 = dd[1, 2], d_10_30 = dd[2, 3], d_30_60 = dd[3, 4],
d_0_30 = dd[1, 3], d_0_60 = dd[1, 4])
}))
w <- w[order(w$first), ]
cat("Plots by group:\n"); print(table(w$group))
cat("\nMedian within-plot distances by group:\n")
print(aggregate(cbind(d_0_10, d_10_30, d_30_60, d_0_30, d_0_60) ~ group, w,
function(x) signif(median(x), 2)))
cat("\nSequence of groups in sample order (runs):\n")
r_seq <- rle(w$group)
print(data.frame(group = r_seq$values, plots = r_seq$lengths,
from = w$first[cumsum(r_seq$lengths) - r_seq$lengths + 1],
to = w$first[cumsum(r_seq$lengths)]), row.names = FALSE)
source("config.R"); source("M_manual/config_M.R")
dat <- readRDS(file.path(DIR_M_PROCESSED, "M02_spectra.rds"))
dat$profile_id <- paste(dat$dataset, dat$profile)
out <- do.call(rbind, lapply(split(seq_len(nrow(dat)), dat$profile_id), function(i) {
i <- i[order(dat$top[i])]
if (length(i) < 3) return(NULL)
Dp <- 0.5 * (1 - cor(t(dat$spc_pretreated[i, , drop = FALSE])))
n <- length(i)
data.frame(location = as.character(dat$location[i[1]]), profile_id = dat$profile_id[i[1]],
first = min(dat$sample_number[i]), n_layers = n,
d_top_second = Dp[1, 2], d_top_last = Dp[1, n])
}))
out$inverted <- out$d_top_last < out$d_top_second
cat("Profiles where the top layer looks more like the deepest layer than the second one:\n")
tab <- table(out$location, out$inverted)
print(cbind(tab, pct_inverted = round(100 * tab[, "TRUE"] / rowSums(tab), 1)))
# Where in the sample sequence the inverted profiles are, by location
for (l in unique(out$location)) {
x <- out[out$location == l, ]
x <- x[order(x$first), ]
if (!any(x$inverted)) next
rr <- rle(x$inverted)
cat("\n", l, ": runs of inverted (TRUE) and normal (FALSE) profiles in sample order\n", sep = "")
print(data.frame(inverted = rr$values, profiles = rr$lengths,
from = x$first[cumsum(rr$lengths) - rr$lengths + 1],
to = x$first[cumsum(rr$lengths)]), row.names = FALSE)
}
